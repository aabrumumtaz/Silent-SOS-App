<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FDFBF7">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Silent SOS"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#4A1525"
        android:layout_marginBottom="8dp" />

    <!-- Dynamic Emergency Number -->
    <TextView
        android:id="@+id/tvEmergencyNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Emergency Number: Not Set"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4A1525"
        android:layout_marginBottom="30dp" />

    <!-- Main SOS Button -->
    <Button
        android:id="@+id/btnSos"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:text="SOS"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4A1525"
        android:elevation="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Instruction Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap in emergency to send SMS &amp; Location"
        android:textSize="13sp"
        android:textColor="#5C1D24"
        android:layout_marginBottom="24dp" />

    <!-- Voice SOS Button -->
    <Button
        android:id="@+id/btnVoiceSos"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🎤 VOICE SOS / SPEAK"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4A1525"
        android:elevation="4dp"
        android:layout_marginBottom="16dp" />

    <!-- AI Scream Detection Module / Toggle Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5EBE6"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Scream Detection (Background)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4A1525" />

        <Switch
            android:id="@+id/btnAiToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>